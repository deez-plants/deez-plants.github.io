# Walks moved to the laptop for transcription.
#
# This repo is PUBLIC - it is the GitHub Pages site. A walk recording is the
# owner's own voice, in their home, talking about their flat. Committing one
# would publish it, and `git rm` afterwards would not un-publish it.
#
# Audio and exported walks stay out of git entirely.
My_content_to_share/
my_content_to_share/
*.m4a
*.webm
*.transcript.txt

# Python bytecode, from running transcribe_walk.py
__pycache__/
*.pyc

# The watcher remembers which folder it is watching.
.watch_walks.json
