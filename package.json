{
  "name": "tmp-scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:build": "tsc -p check/tsconfig.check.json",
    "check": "npm run check:build && node check/derive.check.cjs && node check/seed.check.cjs && node check/coverage.check.cjs && node check/parts.check.cjs && node check/care.check.cjs",
    "check:round": "npm run check:build && node check/round.check.cjs",
    "check:seed": "npm run check:build && node check/seed.check.cjs",
    "check:care": "npm run check:build && node check/care.check.cjs",
    "check:coverage": "npm run check:build && node check/coverage.check.cjs",
    "check:parts": "npm run check:build && node check/parts.check.cjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
